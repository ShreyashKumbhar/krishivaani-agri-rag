# ---------------------------------------------------------------------------
# KrishiVaani configuration
# Copy this file to .env and edit values. No key is required for the default
# local demonstration; every external integration is optional.
# ---------------------------------------------------------------------------

# Storage
AGRI_DB_PATH=backend/data/agrivaani.db

# Generation
# template = deterministic grounded extractive composer (default, no key)
# openai   = any OpenAI-compatible chat-completions endpoint
# ollama   = local Ollama server
LLM_PROVIDER=template
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=45

# Embeddings
# hashed = deterministic multilingual hashed embeddings with glossary concepts (default)
# sentence-transformers = optional neural model, must be installed/downloaded
EMBEDDING_PROVIDER=hashed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Speech
# edge = free Microsoft Edge TTS voices (network required, no key)
# browser = let the web client use SpeechSynthesis (server returns 503)
TTS_PROVIDER=edge
EDGE_VOICE_HI=hi-IN-SwaraNeural
EDGE_VOICE_MR=mr-IN-AarohiNeural
EDGE_VOICE_EN=en-IN-NeerjaNeural
# browser = Web Speech API in the browser (default, no server model)
# faster-whisper = optional server-side ASR (install faster-whisper first)
ASR_PROVIDER=browser
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Mandi prices
# demo = deterministic, clearly labelled simulated data (default)
# data_gov_in = live Agmarknet resource via data.gov.in (requires key)
MANDI_PROVIDER=demo
DATA_GOV_IN_API_KEY=
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Weather
# open-meteo = free live forecast, no key, falls back to labelled demo data
# demo = always simulated
WEATHER_PROVIDER=open-meteo
WEATHER_TIMEOUT_SECONDS=12

# Retrieval and confidence gate
RETRIEVAL_TOP_K=8
EVIDENCE_TOP_K=4
RRF_K=60
MIN_RETRIEVAL_SCORE=0.30
MIN_EVIDENCE_COVERAGE=0.22
MIN_ANSWER_CONFIDENCE=0.52

# Platform
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
ADMIN_USERNAME=admin
ADMIN_PASSWORD=krishivaani-admin
ADMIN_TOKEN=
